# ZN-M2 Network Configuration
# LAN IP: 192.168.12.1

config interface 'loopback'
    option ifname 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'

config globals 'globals'
    option multicast_fast_member_reports '1'
    option ula_prefix 'fd00:1234:5678:abcd::/48'

config interface 'lan'
    option type 'bridge'
    option ifname 'eth0'
    option proto 'static'
    option ipaddr '192.168.12.1'
    option netmask '255.255.255.0'
    option gateway '192.168.12.1'
    option dns '223.5.5.5 223.6.6.6'
    option ipv6 'disabled'

config interface 'wan'
    option ifname 'eth1'
    option proto 'pppoe'
    option username '@your_isp'
    option password '@your_password'
    option ipv6 'auto'
