# Target Platform
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y
CONFIG_TARGET_BOARD="zn_m2"
CONFIG_TARGET_SUBTARGET="ipq60xx"

# 内核与NSS硬件加速核心开关
CONFIG_PACKAGE_kmod-nss-qca=y
CONFIG_NSS_SUPPORT=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-macsec=n
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-clients=y
CONFIG_PACKAGE_kmod-qca-nss-sfp=n
CONFIG_PACKAGE_kmod-qca-nss-gmac=y

# 彻底禁用WiFi（减少内存占用）
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_kmod-hostapd=n
CONFIG_PACKAGE_wpa-supplicant=n
CONFIG_PACKAGE_wireless-regdb=n
CONFIG_PACKAGE_iw=n

# 系统基础组件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y

# USB存储 & Swap支持
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_mountd=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_swap-utils=y
CONFIG_PACKAGE_zram-swap=y

# Docker 容器全套
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y

# iStore商店全套
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_istore-store=y

# 带宽QoS CAKE
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y

# 设备管控：定时断网+流量统计
CONFIG_PACKAGE_luci-app-access-control=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y

# 代理 Mihomo
CONFIG_PACKAGE_luci-app-mihomo=y
CONFIG_PACKAGE_mihomo=y

# ZeroTier异地组网
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# DNS广告拦截（域名黑名单管控短视频）
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y

# IPv6完整支持
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-dhcpv6=y
CONFIG_PACKAGE_ipv6helper=y

# 网络基础
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_pppoe-dial=y
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y

# 关键禁用项（不编译七层DPI，防止内存爆）
CONFIG_PACKAGE_nDPI=n
CONFIG_PACKAGE_luci-app-openappfilter=n
CONFIG_PACKAGE_kmod-ndpi=n

# 镜像格式 NAND UBI 适配M2
CONFIG_TARGET_ROOTFS_UBIFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_SQUASHFS_LZ4=y

# 编译优化
CONFIG_CCACHE=y
CONFIG_BUILD_LOGS=y
CONFIG_KERNEL_CGROUP_MEMORY=y
CONFIG_KERNEL_MEMCG_SWAP=y
