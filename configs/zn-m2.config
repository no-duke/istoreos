# ZN-M2 编译配置 (ImmortalWrt v25.12.1)
# 目标: IPQ6018 (ZN-M2)

# Target Platform
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y

# Network Configuration
CONFIG_DEFAULT_MODEM="192.168.12.1"
CONFIG_DEFAULT_ipaddr="192.168.12.1"

# Kernel
CONFIG_KERNEL_VERSION="6.12"

# NSS Hardware Acceleration
CONFIG_PACKAGE_kmod-nss-qca=y
CONFIG_PACKAGE_qca-nss-ecm=y
CONFIG_PACKAGE_kmod-nss-core=y
CONFIG_PACKAGE_kmod-nss-macsec=y

# Disable WiFi (ZN-M2 has no WiFi)
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_hostapd=n
CONFIG_PACKAGE_wpa-supplicant=n
CONFIG_PACKAGE_wireless-regdb=n
CONFIG_PACKAGE_iw=n

# luci
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y

# SSH and Terminal
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_opkg=y

# Docker
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_kmod-docker=y
CONFIG_PACKAGE_docker-compose=y

# Storage
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-scsi-core=y

# QoS and Monitoring
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y

# Network Tools
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-tables=y
CONFIG_PACKAGE_iptables-mod-nat=y
CONFIG_PACKAGE_iptables-mod-filter=y
CONFIG_PACKAGE_iptables-mod-tunnel=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-netfilter=y

# PassWall (Optional - can be removed if not needed)
# CONFIG_PACKAGE_luci-app-passwall=y
